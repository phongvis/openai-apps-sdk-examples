# ==============================================================================
# .dockerignore - Optimize Docker build context
# ==============================================================================
# This file excludes unnecessary files from the Docker build context,
# reducing build time and final image size.

# Node modules and dependencies (will be installed fresh in Docker)
node_modules/
.pnpm-store/
pnpm-debug.log
npm-debug.log
yarn-error.log

# Build outputs (we rebuild in Docker, so exclude existing builds)
web/dist/
build/
*.map

# Development and cache files
.vite/
coverage/
*.tsbuildinfo
.eslintcache
*.log
.cache/

# Environment files (should be passed as build args or env vars)
.env
.env.local
.env.development
.env.production
.env.*.local

# Editor and IDE files
.DS_Store
.idea/
.vscode/
*.swp
*.swo
*~
.project
.settings/

# Python artifacts (will be regenerated)
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
server/.venv/
.venv/
venv/
.ruff_cache/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# uv lock file needed, but cache is not
.uv/

# Git and version control
.git/
.gitignore
.gitattributes
.github/

# Documentation (not needed in container)
README.md
*.md
docs/

# Standalone projects (not needed in container)
standalone-radar-lite/

# Test files
*.test.ts
*.test.tsx
*.test.js
*.spec.ts
*.spec.tsx
*.spec.js
__tests__/
test/
tests/

# CI/CD files
.circleci/
.travis.yml
azure-pipelines.yml
Jenkinsfile

# Claude Code
.claude/
