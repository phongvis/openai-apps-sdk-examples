# Cloudflare Turnstile site keys
# The default values use Cloudflare's official testing key so local development works out of the box.
CLOUDFLARE_TURNSTILE_SITE_KEY_DEV=1x00000000000000000000AA
CLOUDFLARE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Optional: override the Radar Lite API host
# NEXT_PUBLIC_RADAR_LITE_HOST=https://radar-lite.redsift.cloud/web

# Optional: add your MUI X Pro license if you have one
# NEXT_PUBLIC_MUI_LICENSE_KEY=
